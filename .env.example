# Copy to .env and fill in. .env is not checked in.
#
#     cp .env.example .env
#
# Every variable in config/runtime.exs can be set here; these are the ones you
# need to sign in locally.

# Who may reach /admin/dashboard, as a comma-separated list of GitHub handles.
# These are handles, not display names — the name on the sheet is yours to
# change and would be a poor thing to hang permissions on.
ADMIN_USERS=anehx

# A GitHub OAuth application of your own, from
# https://github.com/settings/developers. Use a separate one for development,
# with the "Authorization callback URL" set to:
#
#     http://localhost:4000/auth/user/github/callback
#
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
